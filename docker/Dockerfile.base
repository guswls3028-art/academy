# ==============================================================================
# 공통 베이스 이미지 (멀티 스테이지 빌드)
# ==============================================================================
# 50명 원장 확장 대비: 이미지 크기 최소화 및 빌드 최적화
# ==============================================================================

# ==============================================================================
# Stage 1: Builder (빌드 도구 포함)
# ==============================================================================
FROM python:3.11-slim@sha256:90744cff8f32887f075c47d747a173ff333e9e98801667af93c357fa9f5e28ff AS builder

ARG APT_REFRESH_TOKEN=manual

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# 빌드 도구 설치 (Gevent 등 C extension 컴파일용)
RUN test -n "${APT_REFRESH_TOKEN}" \
    && apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    dpkg-dev \
    gcc \
    g++ \
    libc6-dev \
    liblzma-dev \
    libpq-dev \
    make \
    patch \
    pkg-config \
    quilt \
    xz-utils \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY docker/native-security/build-fixed-libs.sh /usr/local/bin/build-fixed-libs.sh
RUN sh /usr/local/bin/build-fixed-libs.sh /build/native-security/out

# 의존성 파일 복사 및 설치 (pip 업그레이드와 단일 RUN으로 레이어 최소화)
COPY requirements/constraints.txt ./requirements/constraints.txt
COPY requirements/common.txt ./requirements/common.txt
RUN pip install --upgrade pip && pip install --user --no-cache-dir -r requirements/common.txt

# ==============================================================================
# Stage 2: Runtime (최종 이미지 - 빌드 도구 제거, non-root)
# ==============================================================================
FROM python:3.11-slim@sha256:90744cff8f32887f075c47d747a173ff333e9e98801667af93c357fa9f5e28ff

ARG APT_REFRESH_TOKEN=manual

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app

COPY --from=builder /build/native-security/out /tmp/academy-native-security

# 런타임 의존성만 설치 (빌드 도구 제외)
RUN test -n "${APT_REFRESH_TOKEN}" \
    && apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    ca-certificates \
    fonts-nanum \
    openssl \
    util-linux \
    && dpkg -i /tmp/academy-native-security/*.deb \
    && ldconfig \
    && rm -rf /tmp/academy-native-security \
    && zlib_version="$(dpkg-query -W -f='${Version}' zlib1g)" \
    && dpkg --compare-versions "$zlib_version" ge "1:1.3.3~academy.git20260904.e3dc0a8-1" \
    && pcre2_version="$(dpkg-query -W -f='${Version}' libpcre2-8-0)" \
    && dpkg --compare-versions "$pcre2_version" ge "10.48-2~academy1" \
    && libxml2_version="$(dpkg-query -W -f='${Version}' libxml2)" \
    && dpkg --compare-versions "$libxml2_version" ge "2.15.4+really2.9.14-2.1+deb13u3+academy1" \
    && python -c "import ctypes, zlib; assert zlib.decompress(zlib.compress(b'academy')) == b'academy'; ctypes.CDLL('libxml2.so.2')" \
    && printf 'academy\n' | grep -P '^academy$' \
    && openssl_version="$(dpkg-query -W -f='${Version}' openssl)" \
    && dpkg --compare-versions "$openssl_version" ge "3.5.7-1~deb13u2" \
    && util_linux_version="$(dpkg-query -W -f='${Version}' util-linux)" \
    && dpkg --compare-versions "$util_linux_version" ge "2.41.5-0+deb13u1" \
    && rm -rf /var/lib/apt/lists/* \
    && dpkg --purge --force-remove-essential perl-base \
    && test -z "$(dpkg --audit)" \
    && apt-get check \
    && ! dpkg-query -W perl-base >/dev/null 2>&1 \
    && for package in perl 'perl-modules-*' 'libperl*' libdpkg-perl liberror-perl; do ! dpkg-query -W "$package" >/dev/null 2>&1; done \
    && ! command -v perl >/dev/null 2>&1

# non-root 사용자 (보안·감사 대비, CMD/경로 규칙 유지)
RUN groupadd --gid 1000 appuser \
    && useradd --uid 1000 --gid appuser --create-home --home-dir /home/appuser appuser

WORKDIR /app

# Builder에서 설치한 Python 패키지를 최종 소유권으로 바로 복사한다.
# COPY 후 chown을 별도 RUN으로 수행하면 같은 패키지 바이트가 새 레이어에
# 한 번 더 기록되어 모든 서비스 이미지와 cold pull이 불필요하게 커진다.
COPY --from=builder --chown=appuser:appuser /root/.local /home/appuser/.local
ENV PATH=/home/appuser/.local/bin:$PATH

# Base = 런타임·공통 의존성만. 비즈니스 로직(src, academy, apps)은 서비스별 Dockerfile에서 복사.
# → 코드 변경 시 base 재빌드 불필요, 워커별 필요 코드만 포함 가능.

USER appuser

# 기본 명령어는 서비스별로 오버라이드
CMD ["python", "--version"]
